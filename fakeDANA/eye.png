<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <!-- mask: white = show, black = hide (cutout) -->
    <mask id="slashMask">
      <rect width="100" height="100" fill="white"/>
      <!-- slash cutout -->
      <line x1="22" y1="18" x2="78" y2="82"
            stroke="black" stroke-width="8" stroke-linecap="round"/>
    </mask>
  </defs>

  <g transform="translate(50,50)" mask="url(#slashMask)">
    <!-- eye almond shape -->
    <path d="M-36,0 C-24,-22 -10,-27 0,-27 C10,-27 24,-22 36,0 C24,22 10,27 0,27 C-10,27 -24,22 -36,0 Z"
          fill="white"/>
    <!-- iris ring -->
    <circle cx="0" cy="0" r="13" fill="white"/>
    <!-- pupil hole -->
    <circle cx="0" cy="0" r="7" fill="none" stroke="white" stroke-width="0"/>
  </g>

  <!-- slash line on top (white, visible) -->
  <line x1="22" y1="18" x2="78" y2="82"
        stroke="white" stroke-width="5.5" stroke-linecap="round"/>
</svg>
